{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:disked:schema:acquisition-operation-event:1",
  "title": "Provisional acquisition watch event producer",
  "allOf": [
    {
      "$ref": "urn:disked:schema:event:1"
    },
    {
      "properties": {
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^image-op:[0-9a-f]{32}$"
        },
        "type": {
          "enum": [
            "acquisition.operation.record",
            "acquisition.operation.snapshot"
          ]
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema": {
              "const": "org.disked.acquisition-operation-event/1"
            },
            "request_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "observer_epoch": {
              "type": "string",
              "minLength": 1,
              "pattern": "^watch:[0-9a-f]{32}$"
            },
            "record": {
              "$ref": "urn:disked:schema:acquisition-worker-record:1"
            }
          },
          "required": [
            "schema",
            "request_id",
            "observer_epoch",
            "record"
          ]
        }
      }
    }
  ]
}
