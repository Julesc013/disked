{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:disked:schema:composition:1",
  "title": "composition",
  "type": "object",
  "properties": {
    "schema": {
      "const": "org.disked.composition/1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "target_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "planned",
        "buildable",
        "qualified"
      ]
    },
    "scope": {
      "enum": [
        "fake-only",
        "image-only",
        "qualified-operations"
      ]
    },
    "components": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "mandatory_loader_dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "optional_runtime_components": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "single_entrypoint": {
      "const": true
    },
    "zero_extraction_on_normal_startup": {
      "type": "boolean"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "contains": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "hash_dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "contains",
          "hash_dependencies"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "loader_inventory_status": {
      "enum": [
        "pending",
        "inspected"
      ]
    }
  },
  "required": [
    "schema",
    "id",
    "target_id",
    "status",
    "scope",
    "components",
    "mandatory_loader_dependencies",
    "optional_runtime_components",
    "single_entrypoint",
    "zero_extraction_on_normal_startup",
    "artifacts",
    "evidence",
    "loader_inventory_status"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "buildable",
              "qualified"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "minItems": 1
          },
          "loader_inventory_status": {
            "const": "inspected"
          }
        }
      }
    }
  ]
}
