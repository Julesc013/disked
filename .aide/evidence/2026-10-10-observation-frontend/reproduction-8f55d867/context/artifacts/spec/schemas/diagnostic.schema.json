{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:disked:schema:diagnostic:1",
  "title": "diagnostic",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "error"
      ]
    },
    "message_key": {
      "type": "string",
      "minLength": 1
    },
    "parameters": {
      "type": "object"
    },
    "platform_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "remediation": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "code",
    "severity",
    "message_key",
    "parameters",
    "platform_code",
    "remediation"
  ],
  "additionalProperties": false
}
