{
  "type": "object",
  "properties": {
    "phase": {
      "type": "string",
      "enum": [
        "prepare",
        "execute"
      ]
    },
    "case_operation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 41,
      "pattern": "^image-op:[0-9a-f]{32}$",
      "x-disked-scalar": "acquisition-operation-id"
    },
    "case_directory": {
      "type": "string",
      "minLength": 1,
      "maxLength": 960,
      "x-disked-scalar": "local-state-directory"
    },
    "destination": {
      "type": "string",
      "minLength": 1,
      "maxLength": 960
    },
    "state_directory": {
      "type": "string",
      "minLength": 1,
      "maxLength": 960,
      "x-disked-scalar": "local-state-directory"
    },
    "collection_path": {
      "type": "string", "minLength": 1, "maxLength": 960
    },
    "collection_digest": {
      "type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "x-disked-scalar": "sha256-digest"
    },
    "include_identifiers": {
      "type": "boolean"
    },
    "include_raw_values": {
      "type": "boolean"
    },
    "include_interpretations": {
      "type": "boolean"
    },
    "include_customer_data": {
      "type": "boolean"
    },
    "definition": {
      "type": "object",
      "$ref": "urn:disked:schema:report-worker-definition-parameter:1",
      "x-disked-byte-budget": 65536,
      "x-disked-depth-budget": 28,
      "x-disked-value-budget": 8192,
      "x-disked-string-budget": 1024
    },
    "definition_digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$",
      "x-disked-scalar": "sha256-digest"
    },
    "allow_case_read": {
      "type": "boolean"
    },
    "allow_collection_read": {"type": "boolean"},
    "allow_report_write": {
      "type": "boolean"
    },
    "allow_store_write": {
      "type": "boolean"
    },
    "allow_host_effects": {
      "type": "boolean"
    }
  },
  "required": [
    "phase"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "phase": {
            "const": "prepare"
          }
        }
      },
      "then": {
        "required": [
          "case_operation_id",
          "case_directory",
          "destination",
          "state_directory"
        ],
        "properties": {
          "definition": false,
          "definition_digest": false,
          "allow_case_read": false,
          "allow_collection_read": false,
          "allow_report_write": false,
          "allow_store_write": false,
          "allow_host_effects": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "const": "execute"
          }
        }
      },
      "then": {
        "required": [
          "definition",
          "definition_digest",
          "allow_case_read",
          "allow_report_write",
          "allow_store_write",
          "allow_host_effects"
        ],
        "properties": {
          "case_operation_id": false,
          "case_directory": false,
          "destination": false,
          "state_directory": false,
          "collection_path": false,
          "collection_digest": false,
          "include_identifiers": false,
          "include_raw_values": false,
          "include_interpretations": false,
          "include_customer_data": false,
          "allow_case_read": {
            "const": true
          },
          "allow_report_write": {
            "const": true
          },
          "allow_store_write": {
            "const": true
          },
          "allow_host_effects": {
            "const": true
          }
        }
      }
    },
    {"if": {"required": ["collection_path"]}, "then": {"required": ["collection_digest"]}},
    {"if": {"required": ["collection_digest"]}, "then": {"required": ["collection_path"]}},
    {
      "if": {
        "required": ["phase", "definition"],
        "properties": {
          "phase": {"const": "execute"},
          "definition": {"properties": {"schema": {"const": "org.disked.report-worker-definition-prototype/2"}}}
        }
      },
      "then": {"required": ["allow_collection_read"], "properties": {"allow_collection_read": {"const": true}}},
      "else": {"properties": {"allow_collection_read": false}}
    }
  ],
  "x-disked-form-discriminator": "phase",
  "x-disked-form-default": "prepare",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:disked:schema:export-command-parameters:1",
  "title": "Provisional acquisition-only or explicitly selected acquisition/verification support export parameters"
}
