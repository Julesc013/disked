{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:disked:schema:provider:1",
  "title": "provider",
  "type": "object",
  "properties": {
    "schema": {
      "const": "org.disked.provider/1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "code_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "source_reference": {
      "type": "string",
      "minLength": 1
    },
    "target_profiles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "non_capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "isolation": {
      "type": "string",
      "enum": [
        "unprivileged",
        "broker-built-in",
        "bounded-child",
        "trusted-raw-child",
        "offline",
        "remote"
      ]
    },
    "enforcement_notes": {
      "type": "string",
      "minLength": 1
    },
    "recovery_classes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "conformance_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "admission": {
      "type": "string",
      "enum": [
        "not_admitted",
        "admitted",
        "revoked"
      ]
    },
    "license_expression": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema",
    "id",
    "version",
    "code_digest",
    "source_reference",
    "target_profiles",
    "roles",
    "operations",
    "non_capabilities",
    "isolation",
    "enforcement_notes",
    "recovery_classes",
    "conformance_refs",
    "admission",
    "license_expression"
  ],
  "additionalProperties": false
}
