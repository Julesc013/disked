root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.py]
indent_size = 4

[*.{c,cpp,h}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[.aide/evidence/**]
charset = unset
end_of_line = unset
indent_style = unset
indent_size = unset
trim_trailing_whitespace = false
insert_final_newline = unset
