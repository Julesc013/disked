{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:disked:schema:fat-recursive-response-prototype:1",
  "title": "Provisional recursive FAT common-service response producer",
  "description": "Strict response shape, separate from compatible consumers. Semantic checks bind response status/identity, review hashes, receipts and outcomes. No native freshness, actor authentication, production ABI or physical admission follows from schema validity.",
