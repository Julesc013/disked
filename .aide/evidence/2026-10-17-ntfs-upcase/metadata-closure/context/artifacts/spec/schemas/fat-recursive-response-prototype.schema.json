    {
      "$ref": "urn:disked:schema:response:1"
    },
    {
      "properties": {
        "result": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/preparation"
            },
            {
              "$ref": "#/$defs/execution"
            },
            {
              "$ref": "#/$defs/unresolved"
            },
            {
              "$ref": "#/$defs/observation"
            },
            {
              "$ref": "#/$defs/watch"
            }
          ]
        }
      }
    }
  ],
  "$defs": {
