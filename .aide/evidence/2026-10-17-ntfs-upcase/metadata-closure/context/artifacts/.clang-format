# Modern coordinator policy; it does not require a formatter on deployment hosts.
# Validated with the installed Visual Studio clang-format 19.1.5.
BasedOnStyle: LLVM
IndentWidth: 4
ContinuationIndentWidth: 4
ColumnLimit: 100
UseTab: Never
BreakBeforeBraces: Attach
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
SortIncludes: Never
ReflowComments: false
