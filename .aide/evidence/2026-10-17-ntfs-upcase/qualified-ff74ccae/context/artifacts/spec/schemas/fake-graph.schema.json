{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:disked:schema:fake-graph:1",
  "title": "Private fake graph producer profile",
  "description": "DE-W013 development encoding, not a general provider or production storage ABI. Semantic validation bounds byte counts/u64 and verifies the revision digest.",
  "allOf": [
    {
      "$ref": "urn:disked:schema:graph:1"
    }
  ],
  "properties": {
    "capture_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^fake:[1-9][0-9]{0,19}$"
    },
    "nodes": {
      "maxItems": 64,
      "items": {
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000]+$"
          },
          "kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000]+$"
          },
          "observation_refs": {
            "maxItems": 0
          },
          "properties": {
            "type": "object",
            "properties": {
              "identity": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[^\\u0000]+$"
              },
              "media_generation": {
                "type": "string",
                "pattern": "^[1-9][0-9]{0,19}$"
              },
              "label": {
                "type": "string",
                "maxLength": 4096,
                "pattern": "^[^\\u0000]*$"
              },
              "state": {
                "enum": [
                  "current",
                  "denied",
                  "stale",
                  "unknown"
                ]
              },
              "capacity_bytes": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]{0,19})$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "aliases": {
                "type": "array",
                "maxItems": 64,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^[^\\u0000]+$"
                }
              },
              "scope": {
                "const": "fake-only"
              }
            },
            "required": [
              "identity",
              "media_generation",
              "label",
              "state",
              "capacity_bytes",
              "aliases",
              "scope"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "state": {
                      "const": "current"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "capacity_bytes": {
                      "type": "string",
                      "pattern": "^(0|[1-9][0-9]{0,19})$"
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    "edges": {
      "maxItems": 256,
      "items": {
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000]+$"
          },
          "to": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000]+$"
          },
          "kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000]+$"
          }
        }
      }
    },
    "omissions": {
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[^\\u0000]+$"
      }
    }
  }
}
