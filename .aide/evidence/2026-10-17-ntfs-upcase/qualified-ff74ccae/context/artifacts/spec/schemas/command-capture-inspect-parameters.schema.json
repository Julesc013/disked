{
  "type": "object",
  "properties": {
    "phase": {
      "type": "string",
      "enum": [
        "list",
        "read"
      ]
    },
    "capture_id": {
      "type": "string",
      "minLength": 46,
      "maxLength": 65,
      "pattern": "^fat-capture:[0-9a-f]{32}:[1-9][0-9]{0,19}$",
      "x-disked-scalar": "fat-capture-id"
    },
    "byte_offset": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "maxLength": 20,
      "x-disked-scalar": "decimal-u64"
    },
    "byte_count": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "maxLength": 20,
      "x-disked-scalar": "decimal-u64",
      "x-disked-minimum": 1,
      "x-disked-maximum": 196608
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "phase": {
            "const": "list"
          }
        }
      },
      "then": {
        "properties": {
          "capture_id": false,
          "byte_offset": false,
          "byte_count": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "const": "read"
          }
        },
        "required": [
          "phase"
        ]
      },
      "then": {
        "required": [
          "capture_id",
          "byte_offset",
          "byte_count"
        ]
      }
    }
  ],
  "x-disked-form-discriminator": "phase",
  "x-disked-form-default": "list",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:disked:schema:command-capture-inspect-parameters:1",
  "title": "command-capture-inspect-parameters"
}
