reply=qualified/'build/.cmake/api/v1/reply';model=json.loads(next(reply.glob('codemodel-v2-*.json')).read_bytes());targets={r['id']:r for r in model['configurations'][0]['targets']};names={r['name']:r for r in targets.values()}
def data(n):return json.loads((reply/names[n]['jsonFile']).read_bytes())
def closure(n,seen=None):
 seen=set() if seen is None else seen
 if n in seen:return set()
 seen.add(n);result={source/p['path'] if not Path(p['path']).is_absolute() else Path(p['path']) for p in data(n).get('sources',[]) if Path(p['path']).suffix in ('.c','.cpp')}
 for edge in data(n).get('dependencies',[]):result|=closure(targets[edge['id']]['name'],seen)
 return result
