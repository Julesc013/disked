paths-={source/'source/platform/windows/storage/ntfs_reader.cpp',source/'source/providers/image/ntfs_snapshot.cpp'}
q=lambda p:'"'+p.as_posix()+'"'
cmake=['cmake_minimum_required(VERSION 3.27)','project(NtfsDirectoryPhases LANGUAGES C CXX)','set(CMAKE_CONFIGURATION_TYPES Release CACHE STRING "diagnostic" FORCE)','set(CMAKE_MSVC_RUNTIME_LIBRARY MultiThreaded)','set(CMAKE_C_STANDARD 90)','set(CMAKE_CXX_STANDARD 14)','add_executable(ntfs_phases '+' '.join(q(p) for p in sorted(paths))+' main.cpp ntfs_reader.cpp ntfs_snapshot.cpp)','target_include_directories(ntfs_phases PRIVATE '+q(source/'source')+' '+q(fixture)+')','target_compile_definitions(ntfs_phases PRIVATE _WIN32_WINNT=0x0A00)','target_compile_options(ntfs_phases PRIVATE /W4 /WX /GS /sdl /guard:cf "$<$<COMPILE_LANGUAGE:CXX>:/permissive-;/utf-8>")','target_link_options(ntfs_phases PRIVATE /DYNAMICBASE /NXCOMPAT /HIGHENTROPYVA /guard:cf)','target_link_libraries(ntfs_phases PRIVATE advapi32 userenv)']
