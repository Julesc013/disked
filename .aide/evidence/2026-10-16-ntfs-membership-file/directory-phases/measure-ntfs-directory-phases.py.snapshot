def save(p,v):p.write_text(json.dumps(v,indent=2)+'\n',encoding='utf-8',newline='\n')
def sha(p):return 'sha256:'+hashlib.sha256(p.read_bytes()).hexdigest()
before=json.loads((qualified/'inputs.json').read_bytes());assert all(sha(source/n)==h for n,h in before.items())
save(out/'expected.json',dict(base_revision='9fac1bde5203020e0d1fd4dc92c3bd6b03d78f84',purpose='Diagnostic phase measurements before any qualification retry',not_qualification=True,production_deadlines_unchanged=True,source_inputs_unchanged_before=True,expected='Generated independent large_directory fixture must produce the same completed observation as the canonical command oracle; any refusal/timeout stays failed. Record exact per-phase monotonic and process CPU times; do not assert an invented timing threshold.',scope='One read-only generated ordinary source; temporary instrumented copies only. No canonical source edits, privilege, physical or upstream effects.'))
(fixture/'phases.h').write_text('''#pragma once
#include <windows.h>
#include <cstdio>
inline void ntfs_phase(const char *name) {
    FILETIME c{}, e{}, k{}, u{}; LARGE_INTEGER q{}, f{};
    GetProcessTimes(GetCurrentProcess(), &c, &e, &k, &u);
    QueryPerformanceCounter(&q); QueryPerformanceFrequency(&f);
    const auto cpu = ((static_cast<unsigned long long>(k.dwHighDateTime) << 32) | k.dwLowDateTime)
                   + ((static_cast<unsigned long long>(u.dwHighDateTime) << 32) | u.dwLowDateTime);
    std::fprintf(stderr,"{\\"phase\\":\\"%s\\",\\"pid\\":%lu,\\"ticks\\":%lld,\\"frequency\\":%lld,\\"cpu_100ns\\":%llu}\\n",name,GetCurrentProcessId(),q.QuadPart,f.QuadPart,cpu);
    std::fflush(stderr);
}
''',encoding='utf-8',newline='\n')
reader=(source/'source/platform/windows/storage/ntfs_reader.cpp').read_text();reader='#include "phases.h"\n'+reader.replace('#include "ntfs_reader.h"','#include "platform/windows/storage/ntfs_reader.h"').replace('#include "ntfs_worker.h"','#include "platform/windows/storage/ntfs_worker.h"')
replacements={
