save(out/'inputs.json',{str(p):sha(p) for p in sorted(paths|set(fixture.iterdir()))})
summary=dict(status='running',not_qualification=True,recorded_at=datetime.now(timezone.utc).isoformat(),stages=[])
def run(name,command):
 start=time.monotonic()
 with (out/(name+'.log')).open('wb') as log:p=subprocess.run(list(map(str,command)),stdout=log,stderr=subprocess.STDOUT)
 summary['stages'].append(dict(command=list(map(str,command)),exit_code=p.returncode,seconds=time.monotonic()-start,log=name+'.log'));save(out/'summary.json',summary);print(name,p.returncode,flush=True);assert p.returncode==0
try:
 run('configure',['cmake','-S',fixture,'-B',build,'-G','Visual Studio 17 2022','-A','x64,version=10.0.19041.0','-T','v143,version=14.44.35207,host=x64','-DCMAKE_SYSTEM_VERSION=10.0.19041.0'])
 run('build',['cmake','--build',build,'--config','Release','--parallel','4'])
 summary.update(status='diagnostic-build-pass',executable=str(build/'Release/ntfs_phases.exe'),executable_sha256=sha(build/'Release/ntfs_phases.exe'))
except BaseException as e:summary.update(status='failed',error=repr(e));save(out/'summary.json',summary);raise
summary['source_inputs_unchanged']=all(sha(source/n)==h for n,h in before.items());assert summary['source_inputs_unchanged'];save(out/'summary.json',summary)
