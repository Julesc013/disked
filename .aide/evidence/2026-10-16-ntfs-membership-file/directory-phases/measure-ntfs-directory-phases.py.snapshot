'source.reset(new Source(request.path));':'source.reset(new Source(request.path)); ntfs_phase("reader.source_bound");',
'worker = nt_inventory::NtfsWorker::prepare(input);':'worker = nt_inventory::NtfsWorker::prepare(input); ntfs_phase("reader.prepared");',
'worker->launch();':'ntfs_phase("reader.launch.begin"); worker->launch(); ntfs_phase("reader.launch.end");',
'worker->release();':'ntfs_phase("reader.entered"); worker->release(); ntfs_phase("reader.released");',
'observed = worker->observe(100);':'ntfs_phase("reader.observe.begin"); observed = worker->observe(100); ntfs_phase("reader.observe.end");',
'const auto snapshot = worker->snapshot();':'ntfs_phase("reader.snapshot.begin"); const auto snapshot = worker->snapshot(); ntfs_phase("reader.snapshot.end");',
'const auto retired = finish_exit(*worker);':'ntfs_phase("reader.retire.begin"); const auto retired = finish_exit(*worker); ntfs_phase("reader.retire.end");',
'result.worker = retired;':'result.worker = retired; ntfs_phase("reader.copied");'}
