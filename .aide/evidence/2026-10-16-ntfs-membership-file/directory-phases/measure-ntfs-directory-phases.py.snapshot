repo=Path.cwd();source=repo/'.aide-local/ntfs-membership-file-exact-9fac1bde';qualified=repo/'.aide-local/ntfs-membership-file-qualification-9fac1bde'
out=repo/'.aide/evidence/2026-10-16-ntfs-membership-file/directory-phases';out.mkdir();fixture=out/'fixture';fixture.mkdir()
