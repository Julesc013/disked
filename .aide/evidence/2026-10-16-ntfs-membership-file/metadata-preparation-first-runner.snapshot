source='c1511f80c0e407a755d40cd956b7b467bd4afade';base='887af8ed615bf18a7b0dbeb9f1a37a161ec6d550'
root=Path('.aide/evidence/2026-10-16-ntfs-membership-file')
local=Path('.aide-local/ntfs-membership-file-qualification-c1511f80');winlocal=Path('.aide-local/ntfs-membership-file-win32-c1511f80')
def read(p):return json.loads(Path(p).read_bytes())
def save(p,v):Path(p).write_text(json.dumps(v,indent=2)+'\n',encoding='utf-8',newline='\n')
def sha(p):return 'sha256:'+hashlib.sha256(Path(p).read_bytes()).hexdigest()
