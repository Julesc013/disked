 build=origin/'build';paths=['CMakeCache.txt','Testing/Temporary/LastTest.log']+[p.relative_to(build).as_posix() for p in (build/'CMakeFiles').glob('*/CMake*Compiler.cmake')]
 if origin==local:paths+=['generated/build-identity.json','private-header-usage.json','disked_ntfs_file.vcxproj','disked_ntfs_file_headers.vcxproj','ntfs_file_probe.vcxproj','disked.vcxproj']
