assert q['selected_native_suite_complete'] and not q['full_native_suite_run'] and not q['native_failed'] and not q['native_skipped']
assert q['membership_file_cases']==496 and q['standalone_headers']==67 and q['tooling_tests_run']==247
assert q['inputs_unchanged'] and not q['source_status_before'] and not q['source_status_after']
