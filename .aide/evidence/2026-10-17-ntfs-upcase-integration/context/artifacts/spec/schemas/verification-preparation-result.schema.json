{
  "type": "object",
  "properties": {
    "definition": {
      "$ref": "urn:disked:schema:verification-worker-definition:1"
    },
    "definition_digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$",
      "x-disked-scalar": "sha256-digest"
    },
    "phase": {
      "type": "string",
      "const": "prepare"
    },
    "execution_admitted": {
      "type": "boolean",
      "const": false
    },
    "scope": {
      "type": "string",
      "const": "recorded-acquired-image-verification"
    },
    "authenticity": {
      "type": "string",
      "const": "not_established"
    },
    "latest_image_state": {
      "type": "string",
      "const": "not_established"
    },
    "source_preservation": {
      "type": "string",
      "const": "not_established"
    },
    "physical_admission": {
      "type": "boolean",
      "const": false
    },
    "mutation_authority": {
      "type": "boolean",
      "const": false
    }
  },
  "required": [
    "definition",
    "definition_digest",
    "phase",
    "execution_admitted",
    "scope",
    "authenticity",
    "latest_image_state",
    "source_preservation",
    "physical_admission",
    "mutation_authority"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:disked:schema:verification-preparation-result:1",
  "title": "No-output provisional verification review; no admission"
}
