# Fail before compiler discovery or build output creation.
if(NOT DEFINED ENV{DISKED_WORK_ROOT} OR "$ENV{DISKED_WORK_ROOT}" STREQUAL "")
  message(FATAL_ERROR "DiskEd builds require a managed development workspace. Use python tools/workspace.py run -- COMMAND ...")
endif()
set(_disked_work_root "$ENV{DISKED_WORK_ROOT}")
cmake_path(ABSOLUTE_PATH _disked_work_root NORMALIZE)
set(_disked_repo_root "${CMAKE_CURRENT_LIST_DIR}/..")
cmake_path(ABSOLUTE_PATH _disked_repo_root NORMALIZE)
cmake_path(IS_PREFIX _disked_repo_root "${_disked_work_root}" NORMALIZE _disked_work_in_repo)
if(_disked_work_in_repo)
  message(FATAL_ERROR "Disposable build work must be outside the source checkout, never in .aide-local or build/")
endif()
cmake_path(IS_PREFIX _disked_work_root "${CMAKE_BINARY_DIR}" NORMALIZE _disked_binary_in_work)
if(NOT _disked_binary_in_work)
  message(FATAL_ERROR "CMake binary directory must be inside DISKED_WORK_ROOT")
endif()
