{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:disked:schema:context-manifest:1",
  "title": "context-manifest",
  "type": "object",
  "properties": {
    "schema": {
      "const": "org.disked.context-manifest/1"
    },
    "work_id": {
      "type": "string",
      "pattern": "^DE-[A-Z0-9][A-Z0-9-]*$"
    },
    "git_head": {
      "type": [
        "string",
        "null"
      ]
    },
    "git_dirty": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "additionalProperties": false
      }
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "payload_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "byte_budget": {
      "type": "integer",
      "minimum": 0
    },
    "omitted_optional": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "authority": {
      "const": "context-only-no-execution-grant"
    }
  },
  "required": [
    "schema",
    "work_id",
    "git_head",
    "git_dirty",
    "files",
    "payload_sha256",
    "payload_bytes",
    "byte_budget",
    "omitted_optional",
    "authority"
  ],
  "additionalProperties": false
}
