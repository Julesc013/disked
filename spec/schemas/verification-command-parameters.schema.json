{
  "type": "object",
  "properties": {
    "phase": {
      "type": "string",
      "enum": [
        "prepare",
        "execute"
      ]
    },
    "case_operation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 41,
      "pattern": "^image-op:[0-9a-f]{32}$",
      "x-disked-scalar": "acquisition-operation-id"
    },
    "case_directory": {
      "type": "string",
      "minLength": 1,
      "maxLength": 960,
      "x-disked-scalar": "local-state-directory"
    },
    "image": {
      "type": "string",
      "minLength": 1,
      "maxLength": 960
    },
    "map": {
      "type": "string",
      "minLength": 1,
      "maxLength": 960
    },
    "state_directory": {
      "type": "string",
      "minLength": 1,
      "maxLength": 960,
      "x-disked-scalar": "local-state-directory"
    },
    "definition": {
      "$ref": "urn:disked:schema:verification-worker-definition:1",
      "type": "object",
      "x-disked-byte-budget": 65536,
      "x-disked-depth-budget": 32,
      "x-disked-value-budget": 8192,
      "x-disked-string-budget": 32768
    },
    "definition_digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$",
      "x-disked-scalar": "sha256-digest"
    },
    "allow_case_read": {
      "type": "boolean"
    },
    "allow_image_read": {
      "type": "boolean"
    },
    "allow_map_read": {
      "type": "boolean"
    },
    "allow_store_write": {
      "type": "boolean"
    },
    "allow_host_effects": {
      "type": "boolean"
    },
    "allow_private_metadata": {
      "type": "boolean"
    }
  },
  "required": [
    "phase"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "phase": {
            "const": "prepare"
          }
        }
      },
      "then": {
        "required": [
          "case_operation_id",
          "case_directory",
          "image",
          "map",
          "state_directory"
        ],
        "properties": {
          "definition": false,
          "definition_digest": false,
          "allow_case_read": false,
          "allow_image_read": false,
          "allow_map_read": false,
          "allow_store_write": false,
          "allow_host_effects": false,
          "allow_private_metadata": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "const": "execute"
          }
        }
      },
      "then": {
        "required": [
          "definition",
          "definition_digest",
          "allow_case_read",
          "allow_image_read",
          "allow_map_read",
          "allow_store_write",
          "allow_host_effects",
          "allow_private_metadata"
        ],
        "properties": {
          "case_operation_id": false,
          "case_directory": false,
          "image": false,
          "map": false,
          "state_directory": false,
          "allow_case_read": {
            "const": true
          },
          "allow_image_read": {
            "const": true
          },
          "allow_map_read": {
            "const": true
          },
          "allow_store_write": {
            "const": true
          },
          "allow_host_effects": {
            "const": true
          },
          "allow_private_metadata": {
            "const": true
          }
        }
      }
    }
  ],
  "x-disked-form-discriminator": "phase",
  "x-disked-form-default": "prepare",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:disked:schema:verification-command-parameters:1",
  "title": "Provisional image.verify prepare/execute parameters and exact effects"
}
