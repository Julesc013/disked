{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:disked:schema:command-watch-parameters:1",
  "title": "command-watch-parameters",
  "description": "Bounded fake-operation observer; no start, cancellation or storage authority.",
  "type": "object",
  "properties": {
    "operation_id": {
      "type": "string",
      "minLength": 40,
      "maxLength": 40,
      "pattern": "^fake-op:[0-9a-f]{32}$",
      "x-disked-scalar": "fake-operation-id"
    },
    "state_directory": {
      "type": "string",
      "minLength": 3,
      "maxLength": 960,
      "x-disked-scalar": "local-state-directory"
    },
    "after_sequence": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "x-disked-scalar": "decimal-u64"
    },
    "after_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "x-disked-scalar": "record-digest"
    },
    "worker_epoch": {
      "type": "string",
      "pattern": "^worker:[0-9a-f]{32}$",
      "x-disked-scalar": "worker-epoch"
    },
    "follow_ms": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,3})$",
      "x-disked-scalar": "watch-follow-ms"
    },
    "snapshot": {
      "type": "boolean"
    }
  },
  "required": [
    "operation_id",
    "state_directory"
  ],
  "additionalProperties": false
}
