{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:disked:schema:work-unit:1",
  "title": "work-unit",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^DE-[A-Z0-9][A-Z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "ready",
        "active",
        "needs_review",
        "accepted",
        "blocked"
      ]
    },
    "risk": {
      "type": "string",
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3",
        "R4",
        "R5"
      ]
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^DE-[A-Z0-9][A-Z0-9-]*$"
      }
    },
    "decision_gates": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^DE-[A-Z0-9][A-Z0-9-]*$"
      }
    },
    "context": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^DE-[A-Z0-9][A-Z0-9-]*$"
      },
      "minItems": 1
    },
    "allowed_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "forbidden_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "forbidden_operations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "validation_commands": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "stop_state": {
      "const": "needs_review"
    },
    "authorization": {
      "const": "separate-grant-required"
    },
    "required_inputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "required": [
    "id",
    "title",
    "phase",
    "status",
    "risk",
    "dependencies",
    "decision_gates",
    "context",
    "allowed_paths",
    "forbidden_paths",
    "forbidden_operations",
    "deliverables",
    "acceptance",
    "validation_commands",
    "stop_state",
    "authorization",
    "required_inputs"
  ],
  "additionalProperties": false
}
